# Copy to .env and fill in. Full reference: content/docs/environment-variables.md

# Deployment ------------------------------------------------------------------
# "self-hosted" disables billing entirely: no subscription required, billing
# page hidden, no payment credentials needed. Anything else means the paid
# hosted mode.
DEPLOYMENT_MODE=self-hosted
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database --------------------------------------------------------------------
# Docker Compose overrides this for you. Override here only if you bring your
# own Postgres. A *.neon.tech host uses Neon's HTTP driver; anything else uses
# a standard TCP connection.
DATABASE_URL=postgres://app:app@postgres:5432/app
# Used only by drizzle-kit when applying migrations. Neon requires a direct,
# non-pooled connection for those; plain Postgres draws no distinction, so on a
# self-hosted install this is the same URL.
DATABASE_URL_UNPOOLED=postgres://app:app@postgres:5432/app

# Authentication — https://clerk.com ------------------------------------------
# Organizations must be ENABLED on your Clerk instance. Every workflow belongs
# to an organization, not to a user.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/workflows
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/workflows

# Background runs — https://trigger.dev ---------------------------------------
# REQUIRED SETUP: this key alone is not enough. You must also edit the `project`
# field in trigger.config.ts to your own project reference, and deploy the task
# code with `npx trigger.dev@latest deploy`.
# Workflow runs DO NOT WORK until you do. See content/docs/trigger-dev.md
TRIGGER_SECRET_KEY=
# A personal access token, only needed to run the deploy from inside the stack
# with `docker compose run --rm trigger-deploy`. Create one in the Trigger.dev
# dashboard under your account settings.
TRIGGER_ACCESS_TOKEN=
# Only when running your own Trigger.dev instance rather than their cloud.
# TRIGGER_API_URL=

# Realtime canvas — https://liveblocks.io -------------------------------------
NEXT_PUBLIC_LIVEBLOCKS_PUBLIC_KEY=
LIVEBLOCKS_SECRET_KEY=

# Cloud browsers — https://browserbase.com ------------------------------------
# Also powers session replays, and model inference for the act, extract,
# observe, and agent nodes routes through Browserbase's model gateway.
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# Email — https://resend.com (optional) ---------------------------------------
# Only needed for the Send Email node.
RESEND_API_KEY=
# Verified-domain sender. Unset falls back to Resend's sandbox sender, which
# only delivers to the account owner's own address.
RESEND_FROM="Relayys <noreply@relayys.com>"

# Billing — https://dodopayments.com ------------------------------------------
# NOT needed when DEPLOYMENT_MODE=self-hosted.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PRO_PRODUCT_ID=
